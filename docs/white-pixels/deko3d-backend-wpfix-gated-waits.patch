+    /* DU flight speed and finishing moves: the full-screen scene copy and the
+     * radial blurs come out with white 4x16 bars in some frames unless the GPU
+     * is idle when they start. Barriers, a tiled cache
+     * flush and invalidating the shader and descriptor caches do not help
+     * (docs/white-pixels/RESOCONTO.md). Here, because a submit recycles the
+     * data ring. The copy runs before the blur of its own frame and also in
+     * duels, where waiting brings green bands: it waits only while the radial
+     * blur has been drawn in the last frames. */
+    { enum { WP_BLUR_RECENT = 16u };   /* presents; flight skips a few blurs */
+      static u32 last_blur;
+      static int blur_seen;
+      if (P->ps_hash == 0x4F4A075BB8184542ull) {
+          s_wp_blur_4f4a++; s_wp_frame_blurs++; s_wp_wait_4f4a++;
+          last_blur = s_present_serial;
+          blur_seen = 1;
+          dk_submit_wait();
+      } else if (P->ps_hash == 0x98272F5DC7F7C421ull) {
+          s_wp_blur_9827++; s_wp_frame_blurs++; s_wp_wait_9827++;
+          dk_submit_wait();
+      } else if (P->ps_hash == 0x43B4C9959FAACEC2ull) {
+          if (blur_seen && s_present_serial - last_blur <= WP_BLUR_RECENT) {
+              s_wp_wait_copy++;
+              dk_submit_wait();
+          } else {
+              s_wp_skip_copy++;
+          }
+      } }
