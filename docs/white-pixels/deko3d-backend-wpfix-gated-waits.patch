+/* ---- white-pattern watch (capture builds only) ----------------------------
+ * Counts the frames that show the white bars of the DU flight blur (see the
+ * GPU idle in be_draw and docs/white-pixels/RESOCONTO.md). Every present of a
+ * capture build reads the presented image back. */
+#define DK_WP_BIG   2000u   /* white runs of a clear pattern                 */
+#define DK_WP_SMALL 1000u   /* a small one: ordinary images stay under 900   */
+static u32 s_wp_blur_4f4a, s_wp_blur_9827;   /* draws of each radial blur */
+static u32 s_wp_frame_blurs;                 /* radial blurs since the last present */
+/* GPU waits of be_draw since the last [wp-wait] line, in every build. */
+static u32 s_wp_wait_copy, s_wp_skip_copy, s_wp_wait_4f4a, s_wp_wait_9827;
+
+/* The pattern repeats every 64 pixels along a row at 1280x720 (blocks or bar
+ * groups), with nothing white half a period away. Counts, on every 4th row,
+ * pure-white pixels whose +64 neighbour is white and +32 neighbour is not.
+ * Checked on recorded frames: pattern 4000..34000, ordinary flight under
+ * 400, the anime movies' white streaks under 900. */
+static u32 dk_wp_count_runs(const u8* rgba, u32 w, u32 h, u32 pitch)
+{
+    u32 n = 0;
+    if (w <= 64u) return 0;
+    for (u32 y = 0; y < h; y += 4u) {
+        const u8* r = rgba + (size_t)y * pitch;
+        for (u32 x = 0; x + 64u < w; x++) {
+            const u8* a = r + x * 4u;
+            const u8* b = a + 64u * 4u;
+            const u8* m = a + 32u * 4u;
+            if (a[0] >= 245 && a[1] >= 245 && a[2] >= 245 &&
+                b[0] >= 245 && b[1] >= 245 && b[2] >= 245 &&
+                !(m[0] >= 245 && m[1] >= 245 && m[2] >= 245))
+                n++;
+        }
+    }
+    return n;
+}
+
+static void dk_wp_watch(void* user, u32 surface)
+{
+    static u32 tick = 0, checks = 0, hits = 0, small = 0, win_checks = 0, win_hits = 0, win_small = 0;
+    static u32 events = 0;
+    static u8* buf = NULL;
+    static size_t cap = 0;
+    if (!dbz3_capture_frame) return;   /* capture builds only */
+    tick++;
+    const u32 frame_blurs = s_wp_frame_blurs;
+    s_wp_frame_blurs = 0;
+    dk_target* t = &s_dk.surfaces[surface];
+    if (!t->used || t->fmt != RSX_BE_FMT_R8G8B8A8 || !t->logical_w || !t->logical_h) return;
+    const u32 w = t->logical_w, h = t->logical_h, pitch = w * 4u;
+    if ((size_t)pitch * h > cap) {
+        u8* n = (u8*)realloc(buf, (size_t)pitch * h);
+        if (!n) return;
+        buf = n;
+        cap = (size_t)pitch * h;
+    }
+    be_readback(user, surface, 0, 0, w, h, buf, pitch);
+    const u32 runs = dk_wp_count_runs(buf, w, h, pitch);
+    checks++;
+    win_checks++;
+    if (runs >= DK_WP_BIG) { hits++; win_hits++; }
+    else if (runs >= DK_WP_SMALL) { small++; win_small++; }
+    /* Every frame with the pattern: when, how large, and what ran before it. */
+    if (runs >= DK_WP_SMALL && events < 300u) {
+        events++;
+        fprintf(stderr, "[wp] event %u present %u at %llu ms: %u white runs, blurs since last present %u,"
+                " blur totals 4f4a %u, 98272 %u\n",
+                events, tick, (unsigned long long)(dk_now_us() / 1000u), runs, frame_blurs,
+                s_wp_blur_4f4a, s_wp_blur_9827);
+        fflush(stderr);
+    }
+    /* About every 30 s (1800 presents at 60 Hz). */
+    if (win_checks >= 1800u) {
+        fprintf(stderr, "[wp] window: %u clear, %u small in %u frames (total %u clear, %u small in %u),"
+                " blur draws 4f4a %u, 98272 %u\n",
+                win_hits, win_small, win_checks, hits, small, checks, s_wp_blur_4f4a, s_wp_blur_9827);
+        fflush(stderr);
+        win_checks = win_hits = win_small = 0;
+        s_wp_blur_4f4a = s_wp_blur_9827 = 0;
+    }
+}
