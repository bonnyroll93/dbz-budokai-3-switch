+/* ---- white-pattern watch (capture builds only) ----------------------------
+ * DU flight blur and finishing-move cutscenes show, in a few frames, white
+ * 8x8 blocks (16x16 at 1280x720) in a zig-zag over one triangle of a
+ * full-screen pass. Every 4th present of a capture build reads the presented
+ * image back and counts short runs of pure white; when the pattern is there,
+ * every RGBA8 colour target and every 1280x720 RGBA8 texture is written to
+ * captures/ as it stands at that present, to see which one holds it first. */
+static int dk_wp_write_ppm(const char* path, const u8* rgba, u32 w, u32 h, u32 pitch)
+{
+    FILE* f = fopen(path, "wb");
+    if (!f) return 0;
+    fprintf(f, "P6\n%u %u\n255\n", w, h);
+    u8* row = (u8*)malloc((size_t)w * 3u);
+    if (!row) { fclose(f); return 0; }
+    for (u32 y = 0; y < h; y++) {
+        const u8* s = rgba + (size_t)y * pitch;
+        for (u32 x = 0; x < w; x++) {
+            row[x * 3u + 0u] = s[x * 4u + 0u];
+            row[x * 3u + 1u] = s[x * 4u + 1u];
+            row[x * 3u + 2u] = s[x * 4u + 2u];
+        }
+        fwrite(row, 1, (size_t)w * 3u, f);
+    }
+    free(row);
+    fclose(f);
+    return 1;
+}
+
+/* The whole mip-0 image of a 4-byte linear target or texture, at its physical
+ * size, through the staging block. */
+static int dk_wp_dump_image(dk_target* t, const char* path)
+{
+    if (!t->used || t->bpp != 4u || t->block || !t->w || !t->h) return 0;
+    const u32 row = t->w * 4u;
+    if ((u64)row * t->h > DK_STAGING_SIZE) return 0;
+    DkImageView view;
+    dkImageViewDefaults(&view, &t->image);
+    DkImageRect rect = { 0, 0, 0, t->w, t->h, 1 };
+    DkCopyBuf dst = { dkMemBlockGetGpuAddr(s_dk.mem_staging), 0, 0 };
+    dk_full_barrier();
+    dkCmdBufCopyImageToBuffer(s_dk.cmd, &view, &rect, &dst, 0);
+    dk_full_barrier();
+    dk_submit_wait();
+    dkMemBlockFlushCpuCache(s_dk.mem_staging, 0, row * t->h);
+    return dk_wp_write_ppm(path, (const u8*)dkMemBlockGetCpuAddr(s_dk.mem_staging),
+                           t->w, t->h, row);
+}
+
+/* The pattern repeats every 64 pixels along a row at 1280x720 (blocks or bar
+ * groups), with nothing white half a period away. Counts, on every 4th row,
+ * pure-white pixels whose +64 neighbour is white and +32 neighbour is not.
+ * Checked on recorded frames: pattern 4000..34000, ordinary flight under
+ * 400, the anime movies' white streaks under 900. */
+static u32 dk_wp_count_runs(const u8* rgba, u32 w, u32 h, u32 pitch)
+{
+    u32 n = 0;
+    if (w <= 64u) return 0;
+    for (u32 y = 0; y < h; y += 4u) {
+        const u8* r = rgba + (size_t)y * pitch;
+        for (u32 x = 0; x + 64u < w; x++) {
+            const u8* a = r + x * 4u;
+            const u8* b = a + 64u * 4u;
+            const u8* m = a + 32u * 4u;
+            if (a[0] >= 245 && a[1] >= 245 && a[2] >= 245 &&
+                b[0] >= 245 && b[1] >= 245 && b[2] >= 245 &&
+                !(m[0] >= 245 && m[1] >= 245 && m[2] >= 245))
+                n++;
+        }
+    }
+    return n;
+}
+
+static void dk_wp_watch(void* user, u32 surface)
+{
+    static u32 tick = 0, dumps = 0, checks = 0, hits = 0, win_checks = 0, win_hits = 0;
+    static u8* buf = NULL;
+    static size_t cap = 0;
+    if (!dbz3_capture_frame) return;   /* capture builds only */
+    if (++tick % 4u) return;
+    dk_target* t = &s_dk.surfaces[surface];
+    if (!t->used || t->fmt != RSX_BE_FMT_R8G8B8A8 || !t->logical_w || !t->logical_h) return;
+    const u32 w = t->logical_w, h = t->logical_h, pitch = w * 4u;
+    if ((size_t)pitch * h > cap) {
+        u8* n = (u8*)realloc(buf, (size_t)pitch * h);
+        if (!n) return;
+        buf = n;
+        cap = (size_t)pitch * h;
+    }
+    be_readback(user, surface, 0, 0, w, h, buf, pitch);
+    const u32 runs = dk_wp_count_runs(buf, w, h, pitch);
+    if (++checks <= 3u)
+        fprintf(stderr, "[wp] check %u: presented surface %u %ux%u, %u white runs\n",
+                checks, surface, w, h, runs);
+    const int hit = runs >= 2000u;
+    win_checks++;
+    if (hit) { hits++; win_hits++; }
+    /* About every 30 s (450 checks x 4 presents at 60 Hz): how many checked
+     * frames showed the pattern, in this window and since start. */
+    if (win_checks >= 450u) {
+        fprintf(stderr, "[wp] window: %u/%u checked frames with the pattern (total %u/%u)%s\n",
+                win_hits, win_checks, hits, checks,
+                s_dk.barrier_full ? " [barrier-full]" : "");
+        fflush(stderr);
+        win_checks = win_hits = 0;
+    }
+    /* Dumps off for the barrier A/B test (run200 already has two sets). */
+    if (!hit || dumps >= 0u) return;
+    const u32 n = ++dumps;
+    char path[192];
+    mkdir("sdmc:/switch/dbz-budokai-3-switch/captures", 0777);
+    fprintf(stderr, "[wp] pattern #%u at watched present %u: surface %u, %u white runs; dumping\n",
+            n, tick, surface, runs);
+    fflush(stderr);
+    snprintf(path, sizeof path, "sdmc:/switch/dbz-budokai-3-switch/captures/wp%u_final_s%u.ppm",
+             n, surface);
+    dk_wp_write_ppm(path, buf, w, h, pitch);
+    for (u32 i = 1; i <= DK_MAX_SURFACES; i++) {
+        dk_target* s = &s_dk.surfaces[i];
+        if (!s->used || s->fmt != RSX_BE_FMT_R8G8B8A8) continue;
+        snprintf(path, sizeof path,
+                 "sdmc:/switch/dbz-budokai-3-switch/captures/wp%u_surf%02u_%ux%u.ppm",
+                 n, i, s->logical_w, s->logical_h);
+        const int ok = dk_wp_dump_image(s, path);
+        fprintf(stderr, "[wp]   surface %u %ux%u (physical %ux%u) mem 0x%X%s\n", i,
+                s->logical_w, s->logical_h, s->w, s->h, s->mem_off, ok ? "" : " not written");
+        fflush(stderr);
+    }
+    for (u32 i = 0; i < DK_MAX_TEXTURES; i++) {
+        dk_target* s = &s_dk.textures[i];
+        if (!s->used || s->w != 1280u || s->h != 720u) continue;
+        snprintf(path, sizeof path,
+                 "sdmc:/switch/dbz-budokai-3-switch/captures/wp%u_tex%04u_%ux%u.ppm",
+                 n, DK_TEX_BASE + i, s->w, s->h);
+        const int ok = dk_wp_dump_image(s, path);
+        fprintf(stderr, "[wp]   texture %u %ux%u fmt %d mem 0x%X%s\n", DK_TEX_BASE + i,
+                s->w, s->h, (int)s->fmt, s->mem_off, ok ? "" : " not written");
+        fflush(stderr);
+    }
+}
