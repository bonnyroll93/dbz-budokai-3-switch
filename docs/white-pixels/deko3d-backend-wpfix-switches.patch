+/* ---- white-pattern event log (capture builds only) ------------------------
+ * What the backend was asked to do in the frame being recorded: draws, colour
+ * clears, CPU writes into targets, 2D blits and texture uploads. In every
+ * frame the white-pattern watch will check, the pattern is also counted at
+ * three points of the post-processing chain (dk_cp_measure): the scene before
+ * its copy, the copy before the radial blur, the blur's output. When the scene
+ * already holds the pattern, the draws of that scene are printed. */
+#define DK_WL_MAX   1024u   /* events held per frame; the newest are kept */
+#define DK_WL_PRINT 600u    /* events printed per range                   */
+#define DK_WL_LOGS  3u      /* event lists printed per session            */
+/* Off: a readback in the middle of the chain waits for the GPU, and with that
+ * wait the pattern never appears (run209: 0 of 1795 measured chains). */
+#define DK_CP_ENABLED 0
+#define DK_CP_HIT   2000u   /* white runs that mean "the pattern is here" */
+#define DK_CP_LINES 40u     /* per-frame [cp] lines printed per session   */
+
+typedef struct dk_wl_rec {
+    char kind;              /* D draw, C clear, W cpu write, B blit, U upload */
+    u32 target, tw, th;
+    u32 a[4];               /* C: rgba bits; W/B: rect; U: mip, w, h; B: a[0..3] dst rect */
+    u32 src;                /* B: source surface */
+    u64 vs, ps;
+    u32 topo, verts, indices, stride;
+    u32 blend_on, blend, cwrite;
+    u32 ps_sum, vtx_sum;
+    u32 tex_mask, tex[4], tex_w[4], tex_h[4], tex_fmt[4];
+    float vp[4];
+    u32 sc[4];
+    float v[4][8];
+} dk_wl_rec;
+
+typedef struct dk_wl_frame { dk_wl_rec* r; u32 n; } dk_wl_frame;
+
+static struct {
+    dk_wl_frame cur, prev;
+    u32 present, logs;
+    int failed;
+} s_wl;
+
+/* Checkpoints of the frame being recorded: 0 scene, 1 copy, 2 blur output,
+ * 3 scene after the blit from the blur, 4 recomposed image before the last
+ * blit, 5 blur output again at the present. */
+#define DK_CP_N 6u
+static struct {
+    u32 tick;               /* presents seen by the watch                 */
+    u32 final_runs;         /* white runs of the presented image          */
+    u32 runs[DK_CP_N], surf[DK_CP_N];
+    u8  seen[DK_CP_N];
+    u32 blur_target, recomp_target;
+    u32 chains, copies;     /* blur and copy draws since the last present */
+    u32 multi_checked, multi_hits, zero_checked;
+    u32 follow, follow_blur, follow_lines; /* presents still to follow after the pattern */
+    u32 dirty_lines;
+    u32 lines, clean_lines, checked, hits, first[DK_CP_N + 1u], clean_with_pattern;
+} s_cp;
+
+static dk_wl_rec* dk_wl_next(char kind)
+{
+    if (!DK_CP_ENABLED || !dbz3_capture_frame || s_wl.failed) return NULL;
+    if (!s_wl.cur.r) {
+        s_wl.cur.r = (dk_wl_rec*)malloc(DK_WL_MAX * sizeof(dk_wl_rec));
+        s_wl.prev.r = (dk_wl_rec*)malloc(DK_WL_MAX * sizeof(dk_wl_rec));
+        if (!s_wl.cur.r || !s_wl.prev.r) {
+            free(s_wl.cur.r); free(s_wl.prev.r);
+            s_wl.cur.r = s_wl.prev.r = NULL;
+            s_wl.failed = 1;
+            return NULL;
+        }
+    }
+    dk_wl_rec* r = &s_wl.cur.r[s_wl.cur.n++ % DK_WL_MAX];
+    memset(r, 0, sizeof *r);
+    r->kind = kind;
+    return r;
+}
+
+static u32 dk_wl_sum(const void* data, u32 bytes)
+{
+    const u8* p = (const u8*)data;
+    u32 h = 2166136261u;
+    if (bytes > 1024u) bytes = 1024u;
+    for (u32 i = 0; p && i < bytes; i++) h = (h ^ p[i]) * 16777619u;
+    return h;
+}
+
+static void dk_wl_target(dk_wl_rec* r, u32 surface)
+{
+    r->target = surface;
+    if (surface && surface <= DK_MAX_SURFACES) {
+        r->tw = s_dk.surfaces[surface].logical_w;
+        r->th = s_dk.surfaces[surface].logical_h;
+    }
+}
+
+static void dk_wl_draw(const dk_pipe* P, u32 rt0, u32 topology, const void* vertices,
+                       u32 vertex_count, u32 stride, u32 index_count)
+{
+    dk_wl_rec* r = dk_wl_next('D');
+    if (!r) return;
+    dk_wl_target(r, rt0);
+    r->vs = P->vs_hash; r->ps = P->ps_hash;
+    r->topo = topology; r->verts = vertex_count; r->indices = index_count; r->stride = stride;
+    r->blend_on = P->color.blendEnableMask;
+    memcpy(&r->blend, &P->blend, sizeof r->blend < sizeof P->blend ? sizeof r->blend : sizeof P->blend);
+    memcpy(&r->cwrite, &P->cwrite, sizeof r->cwrite < sizeof P->cwrite ? sizeof r->cwrite : sizeof P->cwrite);
+    r->ps_sum = dk_wl_sum(s_dk.draw.ps_data, s_dk.draw.ps_bytes);
+    r->vtx_sum = dk_wl_sum(vertices, vertex_count * stride);
+    r->tex_mask = s_dk.draw.tex_mask;
+    u32 slot = 0;
+    for (u32 u = 0; u < 16u && slot < 4u; u++) {
+        if (!((s_dk.draw.tex_mask >> u) & 1u)) continue;
+        const u32 h = s_dk.draw.tex[u];
+        const dk_target* t = NULL;
+        if (h >= 1u && h <= DK_MAX_SURFACES) t = &s_dk.surfaces[h];
+        else if (h >= DK_TEX_BASE && h < DK_TEX_BASE + DK_MAX_TEXTURES) t = &s_dk.textures[h - DK_TEX_BASE];
+        else if (h >= DK_VIEW_BASE && h < DK_VIEW_BASE + DK_MAX_VIEWS && s_dk.views[h - DK_VIEW_BASE].used)
+            t = &s_dk.surfaces[s_dk.views[h - DK_VIEW_BASE].surface];
+        r->tex[slot] = h;
+        if (t && t->used) { r->tex_w[slot] = t->w; r->tex_h[slot] = t->h; r->tex_fmt[slot] = (u32)t->fmt; }
+        slot++;
+    }
+    memcpy(r->vp, s_dk.draw.vp, sizeof r->vp);
+    memcpy(r->sc, s_dk.draw.sc, sizeof r->sc);
+    const u32 each = stride < sizeof r->v[0] ? stride : (u32)sizeof r->v[0];
+    for (u32 v = 0; v < vertex_count && v < 4u; v++)
+        memcpy(r->v[v], (const u8*)vertices + (size_t)v * stride, each);
+}
+
+/* Events from..to of a frame's held list (0 = the oldest still held). */
+static void dk_wl_print(const char* tag, u32 log_no, const dk_wl_frame* f, u32 from, u32 to)
+{
+    const u32 have = f->n < DK_WL_MAX ? f->n : DK_WL_MAX;
+    const u32 base = f->n - have;
+    if (to > have) to = have;
+    if (to > from && to - from > DK_WL_PRINT) from = to - DK_WL_PRINT;
+    fprintf(stderr, "[wl] log %u %s: %u events, printing %u..%u\n", log_no, tag, f->n, from, to);
+    for (u32 i = from; i < to; i++) {
+        const dk_wl_rec* r = &f->r[(base + i) % DK_WL_MAX];
+        char line[512];
+        int at = snprintf(line, sizeof line, "[wl] %u %s %u %c rt %u %ux%u", log_no, tag, i,
+                          r->kind, r->target, r->tw, r->th);
+        if (r->kind == 'D') {
+            at += snprintf(line + at, sizeof line - (size_t)at,
+                           " vs %016llX ps %016llX topo %u v %u i %u st %u blend %X/%08X cw %08X"
+                           " pc %08X vd %08X vp %.0f,%.0f,%.0f,%.0f sc %u,%u,%u,%u texmask %X",
+                           (unsigned long long)r->vs, (unsigned long long)r->ps, r->topo, r->verts,
+                           r->indices, r->stride, r->blend_on, r->blend, r->cwrite, r->ps_sum,
+                           r->vtx_sum, r->vp[0], r->vp[1], r->vp[2], r->vp[3], r->sc[0], r->sc[1],
+                           r->sc[2], r->sc[3], r->tex_mask);
+            for (u32 t = 0; t < 4u && r->tex[t]; t++)
+                at += snprintf(line + at, sizeof line - (size_t)at, " t=%u:%ux%u:f%u", r->tex[t],
+                               r->tex_w[t], r->tex_h[t], r->tex_fmt[t]);
+        } else {
+            at += snprintf(line + at, sizeof line - (size_t)at, " src %u args %08X %08X %08X %08X",
+                           r->src, r->a[0], r->a[1], r->a[2], r->a[3]);
+        }
+        fprintf(stderr, "%s\n", line);
+        if (r->kind == 'D' && r->verts <= 8u) {
+            for (u32 v = 0; v < r->verts && v < 4u; v++)
+                fprintf(stderr, "[wl]   v%u %.5g %.5g %.5g %.5g | %.5g %.5g %.5g %.5g\n", v,
+                        r->v[v][0], r->v[v][1], r->v[v][2], r->v[v][3],
+                        r->v[v][4], r->v[v][5], r->v[v][6], r->v[v][7]);
+        }
+    }
+    fflush(stderr);
+}
+
+/* The scene of the presented frame: what the previous list recorded after its
+ * own post-processing ended, then this list up to the first 640x360 draw. */
+static void dk_wl_print_scene(u32 log_no)
+{
+    const dk_wl_frame* p = &s_wl.prev;
+    const dk_wl_frame* c = &s_wl.cur;
+    const u32 ph = p->n < DK_WL_MAX ? p->n : DK_WL_MAX, pb = p->n - ph;
+    const u32 ch = c->n < DK_WL_MAX ? c->n : DK_WL_MAX, cb = c->n - ch;
+    u32 from = 0, to = ch;
+    for (u32 i = 0; i < ph; i++) {
+        const dk_wl_rec* r = &p->r[(pb + i) % DK_WL_MAX];
+        if (r->kind == 'B' && r->target == 3u) from = i + 1u;
+    }
+    for (u32 i = 0; i < ch; i++) {
+        const dk_wl_rec* r = &c->r[(cb + i) % DK_WL_MAX];
+        if (r->kind == 'D' && r->tw == 640u && r->th == 360u) { to = i; break; }
+    }
+    dk_wl_print("scene-prev", log_no, p, from, ph);
+    dk_wl_print("scene-cur", log_no, c, 0u, to);
+}
+
+/* Where the pattern first shows in a checked frame, and running totals. */
+static void dk_cp_report(int hit)
+{
+    u32 first = DK_CP_N;
+    for (u32 i = DK_CP_N; i-- > 0u; )
+        if (s_cp.seen[i] && s_cp.runs[i] >= DK_CP_HIT) first = i;
+    s_cp.checked++;
+    if (s_cp.chains > 1u) { s_cp.multi_checked++; if (hit) s_cp.multi_hits++; }
+    if (!s_cp.chains) s_cp.zero_checked++;
+    if (hit) { s_cp.hits++; s_cp.first[first]++; }
+    else if (first != DK_CP_N) s_cp.clean_with_pattern++;
+    /* Every frame with the pattern, and the first post-processed clean ones as
+     * a baseline. */
+    const int dirty = !hit && first != DK_CP_N;
+    const int baseline = !hit && !dirty && s_cp.seen[2] && s_cp.clean_lines < 5u;
+    if (baseline) s_cp.clean_lines++;
+    const int show_dirty = dirty && s_cp.dirty_lines < DK_CP_LINES;
+    if (show_dirty) s_cp.dirty_lines++;
+    if (baseline || show_dirty || (hit && s_cp.lines < DK_CP_LINES)) {
+        if (hit) s_cp.lines++;
+        fprintf(stderr, "[cp] %s %u present %u: scene s%u %d, copy s%u %d, blur s%u %d,"
+                " scene-after-blit s%u %d, recomposed s%u %d, blur-at-present s%u %d, final %u,"
+                " chains %u copies %u\n",
+                hit ? "hit" : dirty ? "clean-final-but-dirty-checkpoint" : "clean",
+                hit ? s_cp.hits : dirty ? s_cp.clean_with_pattern : s_cp.clean_lines, s_wl.present,
+                s_cp.surf[0], s_cp.seen[0] ? (int)s_cp.runs[0] : -1,
+                s_cp.surf[1], s_cp.seen[1] ? (int)s_cp.runs[1] : -1,
+                s_cp.surf[2], s_cp.seen[2] ? (int)s_cp.runs[2] : -1,
+                s_cp.surf[3], s_cp.seen[3] ? (int)s_cp.runs[3] : -1,
+                s_cp.surf[4], s_cp.seen[4] ? (int)s_cp.runs[4] : -1,
+                s_cp.surf[5], s_cp.seen[5] ? (int)s_cp.runs[5] : -1, s_cp.final_runs,
+                s_cp.chains, s_cp.copies);
+        fflush(stderr);
+    }
+    if (hit && first == 0u && s_wl.logs < DK_WL_LOGS && s_wl.cur.r)
+        dk_wl_print_scene(++s_wl.logs);
+    /* The image has the pattern and no blur ran since the last present: all
+     * that was recorded in this window and in the one before. */
+    if (hit && !s_cp.chains && s_wl.logs < DK_WL_LOGS && s_wl.cur.r) {
+        const u32 n = ++s_wl.logs;
+        dk_wl_print("window-before", n, &s_wl.prev, 0u, DK_WL_MAX);
+        dk_wl_print("window-hit", n, &s_wl.cur, 0u, DK_WL_MAX);
+    }
+    /* Follow the next presents: does the pattern reach the screen later, and
+     * how long does it stay? */
+    if (hit || dirty) {
+        s_cp.follow = 3u;
+        s_cp.follow_blur = s_cp.seen[2] ? s_cp.surf[2] : 8u;
+    }
+    if (s_cp.checked % 450u == 0u) {
+        fprintf(stderr, "[cp] summary: %u checked, %u hits; first seen in scene %u, copy %u, blur %u,"
+                " scene-after-blit %u, recomposed %u, blur-at-present %u, final only %u;"
+                " clean frames with the pattern at a checkpoint %u;"
+                " frames with 2+ chains %u, of which hits %u; frames with no chain %u\n",
+                s_cp.checked, s_cp.hits, s_cp.first[0], s_cp.first[1], s_cp.first[2], s_cp.first[3],
+                s_cp.first[4], s_cp.first[5], s_cp.first[6], s_cp.clean_with_pattern,
+                s_cp.multi_checked, s_cp.multi_hits, s_cp.zero_checked);
+        fflush(stderr);
+    }
+}
+
+/* checked: 1 pattern seen in this frame, 0 checked and clean, -1 not checked. */
+static void dk_wl_frame_end(int checked)
+{
+    s_wl.present++;
+    if (DK_CP_ENABLED && checked >= 0) dk_cp_report(checked);
+    memset(s_cp.seen, 0, sizeof s_cp.seen);
+    s_cp.blur_target = s_cp.recomp_target = 0;
+    s_cp.chains = s_cp.copies = 0;
+    if (!s_wl.cur.r) return;
+    const dk_wl_frame t = s_wl.prev;
+    s_wl.prev = s_wl.cur;
+    s_wl.cur = t;
+    s_wl.cur.n = 0;
+}
