+/* Fast guest memory access (PPU_FAST_VM, set by the Switch port build).
+ *
+ * The runtime's vm_read / vm_write are out-of-line and carry a stack of
+ * env-gated diagnostics (watches, hot-spin detectors, null sweeps) that cost a
+ * call and a dozen branches per guest load. Lifted code is mostly loads and
+ * stores, so on the Switch that was a large share of the main thread's time.
+ * Plain memory takes an inline load/store here; everything with semantics goes
+ * to the full functions as before:
+ *   - the first 64 KiB (null pointer reads are reported, null stores dropped);
+ *   - 0x20000000-0x2FFFFFFF (RSX labels and the GCM control block: polls of the
+ *     ref register publish fences);
+ *   - 0xE0000000 and up (raw SPU problem state);
+ *   - stores to a 128-byte line an SPU holds a reservation on (lock-line
+ *     coherence and SPU_EVENT_LR);
+ *   - anything past ppu_vm_size when the bounds check is armed. */
+#if defined(PPU_FAST_VM)
+#include <string.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern uint8_t* vm_base;
+extern uint32_t ppu_vm_size;
+extern const unsigned char* const g_spu_coh_bitmap;
+extern const int* const g_spu_coh_armed;
+extern int g_ppu_fast_vm;   /* 0: every access takes the full path */
+#ifdef __cplusplus
+}
+#endif
+
+static inline int ppu_fvm_plain(uint32_t a, uint32_t n)
+{
+    return g_ppu_fast_vm && a >= 0x10000u && (uint32_t)(a - 0x20000000u) >= 0x10000000u &&
+           a < 0xE0000000u - 8u &&
+           (ppu_vm_size == 0 || (uint64_t)a + n <= ppu_vm_size);
+}
+
+static inline int ppu_fvm_reserved(uint32_t a, uint32_t n)
+{
+    if (__builtin_expect(!*g_spu_coh_armed, 0)) return 0;
+    const uint32_t l0 = a >> 7, l1 = (a + n - 1u) >> 7;
+    return ((g_spu_coh_bitmap[l0 >> 3] >> (l0 & 7)) & 1u) |
