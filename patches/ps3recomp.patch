+/* sys_spu_thread_bind_queue(id, spuq, spuq_num) */
+static int64_t sys_spu_thread_bind_queue_handler(ppu_context* ctx)
+{
+    const uint32_t tid = (uint32_t)ctx->gpr[3];
+    const uint32_t queue = (uint32_t)ctx->gpr[4];
+    const uint32_t num = (uint32_t)ctx->gpr[5];
+    spu_thread_t* t = spu_find_thread(tid);
+    int32_t rc = CELL_OK;
+    if (!t) rc = (int32_t)CELL_ESRCH;
+    else {
+        AcquireSRWLockExclusive(&s_spu_port_lock);
+        int slot = -1;
+        for (int i = 0; i < t->q_bind_n; i++)
+            if (t->q_bind[i].num == num) { slot = i; break; }
+        if (slot >= 0) rc = (int32_t)CELL_EBUSY;
+        else if (t->q_bind_n >= 8) rc = (int32_t)CELL_EAGAIN;
+        else { t->q_bind[t->q_bind_n].num = num; t->q_bind[t->q_bind_n].queue = queue; t->q_bind_n++; }
+        ReleaseSRWLockExclusive(&s_spu_port_lock);
+    }
+    fprintf(stderr, "[SPU] thread_bind_queue tid=0x%X queue=%u spuq_num=0x%08X -> 0x%X\n",
+            tid, queue, num, (uint32_t)rc);
+    ctx->gpr[3] = (uint64_t)(int64_t)rc;
+    return rc;
+}
+
+/* sys_spu_thread_unbind_queue(id, spuq_num) */
+static int64_t sys_spu_thread_unbind_queue_handler(ppu_context* ctx)
+{
+    const uint32_t tid = (uint32_t)ctx->gpr[3];
+    const uint32_t num = (uint32_t)ctx->gpr[4];
+    spu_thread_t* t = spu_find_thread(tid);
+    int32_t rc = (int32_t)CELL_ESRCH;
+    if (t) {
+        AcquireSRWLockExclusive(&s_spu_port_lock);
+        for (int i = 0; i < t->q_bind_n; i++)
+            if (t->q_bind[i].num == num) {
+                t->q_bind[i] = t->q_bind[--t->q_bind_n];
+                rc = CELL_OK;
+                break;
+            }
+        ReleaseSRWLockExclusive(&s_spu_port_lock);
+    }
+    ctx->gpr[3] = (uint64_t)(int64_t)rc;
+    return rc;
+}
+
+/* The lv2 side of an SPU thread's sys_spu_thread_receive_event (stop 0x110)
+ * and try_receive_event (stop 0x111): the SPU has written the spuq_num to its
+ * outbound mailbox; receive on the queue bound to it and answer through the
+ * inbound mailbox with {CELL_OK, data1, data2, data3}, or a single error
+ * word (RPCS3 spu_thread::stop_and_signal). Returns 0 for any other stop. */
+extern int sys_event_queue_receive_host(uint32_t queue_id, sys_event_t* out, int blocking);
+static int lv2_spu_stop_service(spu_context* c)
+{
+    const uint32_t code = c->stop_code;
+    if (code != 0x110u && code != 0x111u) return 0;
+    spu_thread_t* t = spu_find_thread(c->spu_id);
+    if (!t || !t->q_bind_n) return 0;
+    if (!c->ch_out_mbox.count) {
+        spu_channel_write(&c->ch_in_mbox, (uint32_t)CELL_EINVAL);
+        return 1;
+    }
+    /* The spuq_num is the word written just before the stop. */
+    uint32_t num = 0;
+    while (c->ch_out_mbox.count) num = spu_channel_read(&c->ch_out_mbox);
+    uint32_t queue = 0;
+    AcquireSRWLockShared(&s_spu_port_lock);
+    for (int i = 0; i < t->q_bind_n; i++)
+        if (t->q_bind[i].num == num) { queue = t->q_bind[i].queue; break; }
+    ReleaseSRWLockShared(&s_spu_port_lock);
+    if (!queue) {
+        spu_channel_write(&c->ch_in_mbox, (uint32_t)CELL_EINVAL);
+        return 1;
+    }
+    if (c->ch_in_mbox.count) {               /* lv2: the reply slot must be free */
+        spu_channel_write(&c->ch_in_mbox, (uint32_t)CELL_EBUSY);
+        return 1;
+    }
+    sys_event_t e;
+    const int rc = sys_event_queue_receive_host(queue, &e, code == 0x110u);
+    { static int n = 0; if (n++ < 8)
+        fprintf(stderr, "[SPU] tid=0x%X %sreceive_event spuq_num=0x%08X queue=%u -> 0x%X\n",
+                c->spu_id, code == 0x111u ? "try_" : "", num, queue, (uint32_t)rc); }
+    if (rc != (int)CELL_OK) {
+        spu_channel_write(&c->ch_in_mbox, (uint32_t)rc);
+        return 1;
+    }
+    spu_channel_write(&c->ch_in_mbox, (uint32_t)CELL_OK);
+    spu_channel_write(&c->ch_in_mbox, (uint32_t)e.data1);
+    spu_channel_write(&c->ch_in_mbox, (uint32_t)e.data2);
+    spu_channel_write(&c->ch_in_mbox, (uint32_t)e.data3);
+    return 1;
+}
