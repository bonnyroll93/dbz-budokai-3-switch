+s32 _cellSpursLFQueuePushBody(u64 queue_ea, u64 data_ea, u32 direction)
+{
+    static unsigned calls;
+    if (!queue_ea || !data_ea) return CELL_SPURS_TASK_ERROR_NULL_POINTER;
+    uint32_t q = (uint32_t)queue_ea;
+    uint32_t size = vm_read32(q + 0x10);
+    if (edge_zlib_service((uint32_t)data_ea, size)) return CELL_OK;
+    uint32_t depth = vm_read32(q + 0x0C);
+    uint32_t buffer = (uint32_t)vm_read64(q + 0x18);
+    if (!size || !depth || depth > 128 || size > 4096 || !buffer)
+        return CELL_SPURS_TASK_ERROR_INVAL;
