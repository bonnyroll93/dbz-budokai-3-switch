+    if (!on || size != 32) return 0;
+    const uint32_t src = vm_read32(elem + 0x00), dst = vm_read32(elem + 0x04);
+    const uint32_t src_size = vm_read32(elem + 0x08), dst_size = vm_read32(elem + 0x0C);
+    const uint32_t counter_word = vm_read32(elem + 0x10);
+    const uint32_t flag = vm_read32(elem + 0x14);
+    const u16 bits = vm_read16(elem + 0x18);
