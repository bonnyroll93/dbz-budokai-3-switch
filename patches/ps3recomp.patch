+                int f = -1;
+                for (int z = 0; z < ns; z++) if (seen[z] == lsa) { f = z; break; }
+                if (f < 0 && ns < 8) { f = ns; seen[ns] = lsa; cnt[ns] = 0; ns++; }
+                if (f >= 0) cnt[f]++;
