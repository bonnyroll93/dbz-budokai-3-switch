-    { static int s_c = -1;
-      if (s_c < 0) { const char* e = getenv("SPU_CHHIST");
-        s_c = e ? (atoi(e) > 0 ? atoi(e) : 2000) : 0; }
-      if (s_c) { static unsigned long long c[128]; static unsigned long long n;
-          c[channel & 127]++;
-          if ((++n % (unsigned long long)s_c) == 0) {
-              fprintf(stderr, "[chc] %llu rchcnt:%c", n, 10);
