+/* ---- T34: per-draw vertex fetch cache -------------------------------------
+ *
+ * In a DBZ3 fight the fetch above was 11.6 ms of the ~24 ms the render thread
+ * spent per frame: ~21500 vertices a frame, every attribute of every one
+ * decoded from big-endian into float4, ~540 ns a vertex. The characters are
+ * skinned on the GPU (their bone matrices are the vertex constants the game
+ * uploads every frame), so their vertex and index buffers do not change from
+ * one frame to the next -- and were decoded again identically every frame.
+ *
+ * Each draw gets a 64-bit key over everything the fetch reads: the attribute
+ * descriptors and defaults, the base offset/index, the batch lists, the index
+ * array parameters, the bytes of the index runs and the bytes of every
+ * attribute's source range. Content, not addresses: a buffer the game rewrites
+ * gets a new key and is decoded again. A key seen on two draws is stored; a
+ * later draw with that key reuses the decoded vertices, the occurrence remap
+ * and the restart cuts as they are. Draws whose key changes every frame
+ * (particles, UI) are only hashed, never stored. Inline arrays and
+ * frequency-divided (instanced) attributes are not cached. */
+
+#define EH_P1 0x9E3779B185EBCA87ull
+#define EH_P2 0xC2B2AE3D27D4EB4Full
+#define EH_P3 0x165667B19E3779F9ull
+static inline u64 eh_rotl(u64 x, int r) { return (x << r) | (x >> (64 - r)); }
+static inline u64 eh_round(u64 acc, u64 in)
+{
+    acc += in * EH_P2;
+    return eh_rotl(acc, 31) * EH_P1;
+}
+/* XXH64-style: four independent lanes, 32 bytes a step. */
+static u64 eng_hash_bytes(const void* data, u64 n, u64 seed)
+{
+    const u8* p = (const u8*)data;
+    u64 h;
+    if (n >= 32) {
+        u64 a = seed + EH_P1 + EH_P2, b = seed + EH_P2, c = seed, d = seed - EH_P1;
+        while (n >= 32) {
+            u64 w[4];
+            memcpy(w, p, 32);
+            a = eh_round(a, w[0]); b = eh_round(b, w[1]);
+            c = eh_round(c, w[2]); d = eh_round(d, w[3]);
+            p += 32; n -= 32;
+        }
+        h = eh_rotl(a, 1) + eh_rotl(b, 7) + eh_rotl(c, 12) + eh_rotl(d, 18);
+    } else {
+        h = seed + EH_P3;
+    }
+    while (n >= 8) {
+        u64 w; memcpy(&w, p, 8);
+        h ^= eh_round(0, w);
+        h = eh_rotl(h, 27) * EH_P1 + 0x85EBCA77C2B2AE63ull;
+        p += 8; n -= 8;
+    }
+    while (n--) {
+        h ^= (u64)(*p++) * EH_P3;
+        h = eh_rotl(h, 11) * EH_P1;
+    }
+    h ^= h >> 33; h *= EH_P2; h ^= h >> 29; h *= EH_P3; h ^= h >> 32;
+    return h;
+}
+
+#define ENG_VC_SLOTS      4096u                 /* power of two */
+#define ENG_VC_PROBATION  4096u
+#define ENG_VC_MAX_BYTES  (64ull << 20)
+#define ENG_VC_MAX_RANGE  (8u << 20)            /* per attribute source range */
+typedef struct {
+    u64 key;                /* 0 = empty */
+    u64 last_use;
+    u8* verts;
+    u32* occ;
+    u32* cuts;
+    u32 n_verts, verts_bytes, n_source_refs, n_cuts;
+    int refs_remapped;
+} eng_vc_entry;
+static eng_vc_entry s_vc[ENG_VC_SLOTS];
+static u64 s_vc_probation[ENG_VC_PROBATION];
+static u64 s_vc_bytes, s_vc_tick;
+static int s_vc_enabled = -1;
+/* Per profiler window (t23-draw-prof.log). */
+static u64 s_vc_hits, s_vc_misses, s_vc_stores, s_vc_uncacheable, s_vc_hashed;
+
+static u64 eng_vc_entry_bytes(const eng_vc_entry* e)
+{
+    return (u64)e->verts_bytes + (e->occ ? (u64)e->n_source_refs * 4u : 0u) +
+           (u64)e->n_cuts * 4u;
+}
+
+static void eng_vc_free(eng_vc_entry* e)
+{
+    s_vc_bytes -= eng_vc_entry_bytes(e);
+    free(e->verts); free(e->occ); free(e->cuts);
+    memset(e, 0, sizeof(*e));
+}
+
+/* Key of the current draw group, or 0 when it must not be cached. */
+static u64 eng_vc_key(const rsx_vertex_layout_plan* layout, int allow_remap)
+{
+    if (dc.inl || !layout->count) return 0;
+    struct {
+        u32 mask, stride, count, allow, base_off, base_idx, divider, n_arr, n_idx;
+    } hdr;
+    hdr.mask = layout->mask; hdr.stride = layout->stride; hdr.count = layout->count;
+    hdr.allow = (u32)allow_remap;
+    hdr.base_off = rsx_dsp_vertex_data_base_offset(&g.rsx);
+    hdr.base_idx = rsx_dsp_vertex_data_base_index(&g.rsx);
+    hdr.divider = rsx_dsp_reg(&g.rsx, 0x1FC0);
+    hdr.n_arr = dc.n_arr; hdr.n_idx = dc.n_idx;
+    u64 h = eng_hash_bytes(&hdr, sizeof hdr, 0x5EEDu);
+    h = eng_hash_bytes(dc.arr, (u64)dc.n_arr * sizeof(dc.arr[0]), h);
+    h = eng_hash_bytes(dc.idx, (u64)dc.n_idx * sizeof(dc.idx[0]), h);
+
+    /* The element range every attribute is read over (rsx_vertex_element_index
+     * with frequency <= 1: (vertex + base) & 0xFFFFF; arrays use base 0). */
+    u32 emin = 0xFFFFFFFFu, emax = 0;
+    for (u32 b = 0; b < dc.n_arr; b++) {
+        if (!dc.arr[b].count) continue;
+        const u32 first = dc.arr[b].first, last = first + dc.arr[b].count - 1u;
+        if (last < first || last > 0x000FFFFFu) return 0;     /* would wrap */
+        if (first < emin) emin = first;
+        if (last > emax) emax = last;
+    }
+    if (dc.n_idx) {
+        rsx_dsp_index_array ia;
+        rsx_dsp_get_index_array(&g.rsx, &ia);
+        const u32 esz = ia.is_u32 ? 4u : 2u;
+        const int restart_en = rsx_dsp_restart_index_enabled(&g.rsx, ia.is_u32);
+        const u32 restart_val = rsx_dsp_restart_index(&g.rsx);
+        const u32 ia_loc = ia.location ? RSX_LOCATION_MAIN : RSX_LOCATION_LOCAL;
+        struct { u32 offset, is_u32, loc, restart_en, restart_val; } ih =
+            { ia.offset, (u32)ia.is_u32, ia_loc, (u32)restart_en, restart_val };
+        h = eng_hash_bytes(&ih, sizeof ih, h);
+        for (u32 b = 0; b < dc.n_idx; b++) {
+            const u32 first = dc.idx[b].first, count = dc.idx[b].count;
+            if (!count) continue;
+            const u64 start = (u64)ia.offset + (u64)first * esz;
+            const u64 bytes = (u64)count * esz;
+            if (start + bytes > 0x100000000ull) return 0;
+            const u8* run = eng_guest_ptr(NULL, ia_loc, (u32)start, (u32)bytes);
+            if (!run) return 0;
+            h = eng_hash_bytes(run, bytes, h);
+            s_vc_hashed += bytes;
+            for (u32 i = 0; i < count; i++) {
+                const u8* p = run + (size_t)i * esz;
+                const u32 index = ia.is_u32
+                    ? (((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8) | p[3])
+                    : (u32)((p[0] << 8) | p[1]);
+                if (restart_en && index == restart_val) continue;
+                const u32 e = (index + hdr.base_idx) & 0x000FFFFFu;
+                if (e < emin) emin = e;
+                if (e > emax) emax = e;
+            }
+        }
+    }
+    if (emin > emax) return 0;
+
+    for (u32 slot = 0; slot < layout->count; slot++) {
+        const u32 attr = layout->attrs[slot];
+        rsx_dsp_vertex_attr d;
+        float def[4];
+        rsx_dsp_get_vertex_attr(&g.rsx, attr, &d);
+        rsx_dsp_vertex_default(&g.rsx, attr, def);
+        h = eng_hash_bytes(&d, sizeof d, h);
+        h = eng_hash_bytes(def, sizeof def, h);
+        if (!d.type || !d.size) continue;
+        if (d.frequency > 1) return 0;
+        const u32 elem = rsx_vertex_attrib_size(d.type, d.size);
+        if (!elem) continue;
+        const u32 stride = d.stride ? d.stride : elem;
+        const u64 prefix = (u64)hdr.base_off + (u64)d.offset;
+        const u64 start = prefix + (u64)emin * stride;
+        const u64 end = prefix + (u64)emax * stride + elem;
+        if (end > 0x100000000ull || end <= start || end - start > ENG_VC_MAX_RANGE)
+            return 0;
+        const u8* src = eng_guest_ptr(NULL, d.location, (u32)start, (u32)(end - start));
+        if (!src) return 0;
+        h = eng_hash_bytes(src, end - start, h);
+        s_vc_hashed += end - start;
+    }
+    return h ? h : 1u;
+}
+
+static eng_vc_entry* eng_vc_find(u64 key)
+{
+    u32 i = (u32)(key ^ (key >> 32)) & (ENG_VC_SLOTS - 1u);
+    for (u32 probe = 0; probe < 16u; probe++, i = (i + 1u) & (ENG_VC_SLOTS - 1u))
+        if (s_vc[i].key == key) return &s_vc[i];
+    return NULL;
+}
+
+static void eng_vc_store(u64 key)
+{
+    const u64 vbytes = (u64)dc.n_verts * dc.layout.stride;
+    const int remap = dc.refs_remapped;
+    const u64 need = vbytes + (remap ? (u64)dc.n_source_refs * 4u : 0u) + (u64)dc.n_cuts * 4u;
+    if (!dc.n_verts || need > ENG_VC_MAX_BYTES / 8u || vbytes > 0xFFFFFFFFull) return;
+
+    /* A slot: the home run's empty one, else its least recently used. */
+    u32 i = (u32)(key ^ (key >> 32)) & (ENG_VC_SLOTS - 1u);
+    eng_vc_entry* victim = NULL;
+    for (u32 probe = 0; probe < 16u; probe++, i = (i + 1u) & (ENG_VC_SLOTS - 1u)) {
+        eng_vc_entry* e = &s_vc[i];
+        if (!e->key) { victim = e; break; }
+        if (!victim || e->last_use < victim->last_use) victim = e;
+    }
+    if (victim->key) eng_vc_free(victim);
+    /* Over budget: drop the least recently used entries anywhere. */
+    while (s_vc_bytes + need > ENG_VC_MAX_BYTES) {
+        eng_vc_entry* old = NULL;
+        for (u32 j = 0; j < ENG_VC_SLOTS; j++)
+            if (s_vc[j].key && (!old || s_vc[j].last_use < old->last_use)) old = &s_vc[j];
+        if (!old) break;
+        eng_vc_free(old);
+    }
+
+    eng_vc_entry e;
+    memset(&e, 0, sizeof e);
+    e.verts = (u8*)malloc((size_t)vbytes);
+    e.occ = remap ? (u32*)malloc((size_t)dc.n_source_refs * 4u) : NULL;
+    e.cuts = dc.n_cuts ? (u32*)malloc((size_t)dc.n_cuts * 4u) : NULL;
+    if (!e.verts || (remap && !e.occ) || (dc.n_cuts && !e.cuts)) {
+        free(e.verts); free(e.occ); free(e.cuts);
+        return;
+    }
+    memcpy(e.verts, dc.verts, (size_t)vbytes);
+    if (remap) memcpy(e.occ, dc.ref_remap.occurrence_to_unique, (size_t)dc.n_source_refs * 4u);
+    if (dc.n_cuts) memcpy(e.cuts, dc.cuts, (size_t)dc.n_cuts * 4u);
+    e.key = key;
+    e.last_use = s_vc_tick;
+    e.n_verts = dc.n_verts;
+    e.verts_bytes = (u32)vbytes;
+    e.n_source_refs = dc.n_source_refs;
+    e.n_cuts = dc.n_cuts;
+    e.refs_remapped = remap;
+    *victim = e;
+    s_vc_bytes += need;
+    s_vc_stores++;
+}
+
+static void dc_set_own_views(void)
+{
+    dc.verts_view = dc.verts;
+    dc.occ_view = dc.refs_remapped ? dc.ref_remap.occurrence_to_unique : NULL;
+    dc.cuts_view = dc.cuts;
+}
+
+static void dc_fetch_cached(const rsx_vertex_layout_plan* layout, int allow_remap)
+{
+    if (s_vc_enabled < 0) s_vc_enabled = getenv("RSX_NO_VCACHE") ? 0 : 1;
+    s_vc_tick++;
+    const u64 key = s_vc_enabled ? eng_vc_key(layout, allow_remap) : 0;
+    if (key) {
+        eng_vc_entry* e = eng_vc_find(key);
+        if (e) {
+            e->last_use = s_vc_tick;
+            dc.layout = *layout;
+            dc.fetch_ok = 1;
+            dc.n_verts = dc.n_refs = e->n_verts;
+            dc.n_source_refs = e->n_source_refs;
+            dc.refs_remapped = e->refs_remapped;
+            dc.n_cuts = e->n_cuts;
+            dc.verts_view = e->verts;
+            dc.occ_view = e->refs_remapped ? e->occ : NULL;
+            dc.cuts_view = e->cuts;
+            s_vc_hits++;
+            return;
+        }
+    } else {
+        s_vc_uncacheable++;
+    }
+    dc_fetch(layout, allow_remap);
+    dc_set_own_views();
+    if (!key || !dc.fetch_ok) return;
+    s_vc_misses++;
+    /* Store on the second sighting: a key that never repeats is not worth a
+     * copy. */
+    u64* seen = &s_vc_probation[(u32)(key ^ (key >> 29)) & (ENG_VC_PROBATION - 1u)];
+    if (*seen == key) eng_vc_store(key);
+    else *seen = key;
+}
