+        break;
+    case SPU_WrOutIntrMbox:
+        { static int s_t = -1; if (s_t < 0) s_t = getenv("SPU_MBOXTRACE") ? 1 : 0;
+          if (s_t) fprintf(stderr, "[spu-mbox] INTR grp=0x%X spu=0x%X val=0x%08X\n",
+                           ctx->spu_group_id, ctx->spu_id, v); }
